# Copy this file to .env and replace every replace_* value before starting.
APP_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5173
BACKEND_PORT=8301

DB_HOST=database
DB_PORT=5432
DB_USER=replace_with_database_user
DB_PASSWORD=replace_with_a_unique_database_password
DB_NAME=replace_with_database_name

JWT_SECRET_KEY=replace_with_at_least_32_random_bytes
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8301
LOG_LEVEL=INFO
